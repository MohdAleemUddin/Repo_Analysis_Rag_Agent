{
  "name": "confluence-extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.0.0"
  },
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "confluence.saveToIntelligent",
        "title": "PRD: Save to Confluence (Intelligent)",
        "category": "Confluence"
      },
      {
        "command": "confluence.saveSelection",
        "title": "PRD: Save Selection (AI Formatting)",
        "category": "Confluence"
      },
      {
        "command": "confluence.documentProject",
        "title": "PRD: Document Project Intelligently",
        "category": "Confluence"
      },
      {
        "command": "confluence.viewCreations",
        "title": "PRD: View Intelligent Creations",
        "category": "Confluence"
      },
      {
        "command": "confluence.configureSettings",
        "title": "PRD: Configure AI Settings",
        "category": "Confluence"
      },
      {
        "command": "confluence.configureProjectSettings",
        "title": "PRD: Configure Project Settings",
        "category": "Confluence"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "confluence.saveSelection",
          "when": "editorHasSelection",
          "group": "confluence@1"
        }
      ]
    },
    "configuration": {
      "title": "Confluence",
      "properties": {
        "confluence.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL for edge agent / Confluence API (e.g. http://localhost:8000)"
        },
        "confluence.credentials.url": {
          "type": "string",
          "default": "",
          "description": "Confluence instance URL (e.g. https://your-domain.atlassian.net). API token is stored securely via SecretStorage."
        },
        "confluence.credentials.email": {
          "type": "string",
          "default": "",
          "description": "Email for Confluence API authentication"
        },
        "confluence.defaults.spaceMapping": {
          "type": "object",
          "default": {},
          "description": "Default space key per project type (e.g. python_fastapi -> DEV, react_app -> FRONTEND)"
        },
        "confluence.performance.rateLimit": {
          "type": "number",
          "default": 30,
          "description": "Max requests per minute for Confluence API"
        },
        "confluence.performance.burstLimit": {
          "type": "number",
          "default": 10,
          "description": "Burst limit for rate limiting"
        },
        "confluence.performance.retryAttempts": {
          "type": "number",
          "default": 3,
          "description": "Number of retry attempts for failed requests"
        },
        "confluence.performance.timeouts": {
          "type": "object",
          "default": { "analysis": 3000, "templateSelection": 2000, "pageCreation": 15000, "connection": 5000 },
          "description": "Timeouts in ms: analysis, templateSelection, pageCreation, connection"
        },
        "confluence.performance.cache": {
          "type": "object",
          "default": { "enabled": true, "ttl": 300, "maxSize": 100 },
          "description": "Cache settings: enabled, ttl (seconds), maxSize"
        },
        "confluence.logging.level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
          "default": "INFO",
          "description": "Logging level for Confluence operations"
        },
        "confluence.logging.includeSensitive": {
          "type": "boolean",
          "default": false,
          "description": "Whether to include sensitive data in logs (never include API token)"
        },
        "confluence.logging.maxFileSize": {
          "type": "string",
          "default": "10MB",
          "description": "Max log file size"
        },
        "confluence.learning.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable learning from feedback"
        },
        "confluence.learning.retentionDays": {
          "type": "number",
          "default": 90,
          "description": "Days to retain learning data"
        },
        "confluence.learning.minConfidence": {
          "type": "number",
          "default": 0.7,
          "description": "Minimum confidence threshold for learning"
        },
        "confluence.learning.autoImprove": {
          "type": "boolean",
          "default": true,
          "description": "Auto-improve templates from feedback"
        },
        "confluence.advanced.exportPath": {
          "type": "string",
          "default": "${workspaceFolder}/.confluence/examples",
          "description": "Export path for examples"
        },
        "confluence.advanced.importPath": {
          "type": "string",
          "default": "",
          "description": "Import path for examples"
        },
        "confluence.advanced.autoExport": {
          "type": "boolean",
          "default": false,
          "description": "Auto-export on creation"
        },
        "confluence.templates.overrides": {
          "type": "object",
          "default": { "disabledTemplates": [], "priorityOrder": [], "customTemplatesPath": "" },
          "description": "Template overrides: disabledTemplates, priorityOrder, customTemplatesPath (e.g. ${workspaceFolder}/.confluence/templates)"
        },
        "confluence.intelligence.confidenceThreshold": {
          "type": "number",
          "default": 0.7,
          "description": "Confidence threshold for intelligent decisions"
        },
        "confluence.intelligence.autoTitle": {
          "type": "boolean",
          "default": true,
          "description": "Auto-generate page title"
        },
        "confluence.intelligence.autoSpace": {
          "type": "boolean",
          "default": true,
          "description": "Auto-select space by project type"
        },
        "confluence.intelligence.explainDecisions": {
          "type": "boolean",
          "default": true,
          "description": "Show explanation for AI decisions"
        },
        "confluence.risks.allowOverrides": {
          "type": "boolean",
          "default": true,
          "description": "Allow user overrides for risk mitigation"
        },
        "confluence.risks.showConfidence": {
          "type": "boolean",
          "default": true,
          "description": "Show confidence in UI"
        },
        "confluence.risks.fallbackTemplates": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["mixed_project", "generic"],
          "description": "Fallback template IDs"
        },
        "confluence.risks.maxFileSize": {
          "type": "string",
          "default": "10MB",
          "description": "Max file size for analysis"
        },
        "confluence.mode.intelligent": {
          "type": "boolean",
          "default": true,
          "description": "Use intelligent mode by default; fallback to manual available"
        }
      }
    },
    "configurationDefaults": {
      "confluence.learning.enabled": true,
      "confluence.mode.intelligent": true,
      "confluence.intelligence.confidenceThreshold": 0.7,
      "confluence.intelligence.autoTitle": true,
      "confluence.intelligence.autoSpace": true,
      "confluence.intelligence.explainDecisions": true
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.108.1",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^13.0.1",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  }
}
